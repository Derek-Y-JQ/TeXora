{
  "name": "texora",
  "version": "1.5.1",
  "description": "TeXora — a modern local-first LaTeX editor for Windows with block editing, SyncTeX, local history and controlled AI assistance",
  "main": "electron/main.js",
  "author": "TeXora Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "dev": "vite",
    "test": "node scripts/test.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "verify:cjk": "node tests/test-cjk-preview.cjs",
    "test:143": "node tests/test-143.mjs",
    "test:unit": "node scripts/test.cjs",
    "test:integration": "node tests/test-project-preview.cjs && node tests/test-cjk-preview.cjs",
    "test:electron": "node scripts/test-electron.cjs",
    "test:ui": "node tests/run-ui-preview.mjs"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.18.0",
    "katex": "0.19.1",
    "monaco-editor": "0.57.0",
    "vite": "7.3.1"
  },
  "build": {
    "appId": "com.texora.editor",
    "productName": "TeXora",
    "copyright": "Copyright © 2026 TeXora Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "docs/**/*",
      "samples/**/*",
      "skills/**/*",
      "build/icon.ico",
      "build/icon.png",
      "!samples/**/.latex_cache/**",
      "!samples/**/*.pdf",
      "!samples/**/*.aux",
      "!samples/**/*.log",
      "!samples/**/*.synctex.gz"
    ],
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TeXora-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TeXora",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF 文档",
        "role": "Viewer"
      },
      {
        "ext": "tex",
        "name": "LaTeX Document",
        "description": "LaTeX 源文件",
        "role": "Editor"
      },
      {
        "ext": "ltx",
        "name": "LaTeX Document",
        "role": "Editor"
      },
      {
        "ext": "sty",
        "name": "LaTeX Package",
        "role": "Editor"
      },
      {
        "ext": "cls",
        "name": "LaTeX Class",
        "role": "Editor"
      },
      {
        "ext": "bib",
        "name": "BibTeX Bibliography",
        "role": "Editor"
      },
      {
        "ext": "md",
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "electronDist": "node_modules/electron/dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Derek-Y-JQ/TeXora.git"
  },
  "homepage": "https://github.com/Derek-Y-JQ/TeXora",
  "dependencies": {
    "adm-zip": "0.6.1"
  }
}
