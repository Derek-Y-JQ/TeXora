{
  "name": "texora",
  "version": "1.3.4",
  "description": "TeXora — a modern local-first LaTeX editor for Windows with block editing, SyncTeX, local history and controlled AI assistance",
  "main": "electron/main.js",
  "author": "TeXora Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "dev": "vite",
    "test": "node scripts/test-punctuation.mjs && node scripts/test-131.mjs && node scripts/test-external-links.mjs && node scripts/test-current-fixes.mjs && node scripts/test-133.mjs && node scripts/test-134.mjs",
    "verify:134": "node scripts/run-verify-134.mjs",
    "verify:133": "node scripts/run-verify-133.mjs",
    "verify:131": "node scripts/run-verify-131.mjs",
    "verify:130": "node scripts/run-verify-130.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "capture": "node scripts/cdp.mjs --script scripts/verify-ui.mjs",
    "verify": "node scripts/cdp.mjs --script scripts/verify-interactions.mjs",
    "gallery": "node scripts/cdp.mjs --script scripts/demo-shots.mjs"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.18.0",
    "monaco-editor": "0.57.0",
    "vite": "7.3.1"
  },
  "build": {
    "appId": "com.texora.editor",
    "productName": "TeXora",
    "copyright": "Copyright © 2026 TeXora Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "docs/**/*",
      "samples/**/*",
      "skills/**/*",
      "build/icon.ico",
      "build/icon.png",
      "!samples/**/.latex_cache/**",
      "!samples/**/*.pdf",
      "!samples/**/*.aux",
      "!samples/**/*.log",
      "!samples/**/*.synctex.gz"
    ],
    "asar": false,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TeXora-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TeXora",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": "tex",
        "name": "LaTeX Document",
        "description": "LaTeX 源文件",
        "role": "Editor"
      },
      {
        "ext": "ltx",
        "name": "LaTeX Document",
        "role": "Editor"
      },
      {
        "ext": "sty",
        "name": "LaTeX Package",
        "role": "Editor"
      },
      {
        "ext": "cls",
        "name": "LaTeX Class",
        "role": "Editor"
      },
      {
        "ext": "bib",
        "name": "BibTeX Bibliography",
        "role": "Editor"
      },
      {
        "ext": "md",
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "electronDist": "node_modules/electron/dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Derek-Y-JQ/TeXora.git"
  },
  "homepage": "https://github.com/Derek-Y-JQ/TeXora"
}
